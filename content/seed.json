                          {
                            "id": "skill-development-sample-1",
                            "type": "code-sample",
                            "schemaVersion": 1,
                            "props": {
                              "language": "typescript",
                              "code": "class Greeter {\n  private greeting: string\n\n  constructor(message: string) {\n    this.greeting = message\n  }\n\n  public greet(): string {\n    return this.greeting\n  }\n}"
                            }
                          },
