                    {
                      "id": "cinema-reservation",
                      "type": "project-entry",
                      "schemaVersion": 1,
                      "props": {
                        "title": "Cinema Reservation System",
                        "leadText": "A complete management system for cinemas for movies, rooms, events and reservations. Made as a school project with Vue.js 2 and .NET Core.",
                        "description": {
                          "type": "doc",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "When I was a student we had a long term project in which we all had to build a fullstack project on our own. My project was a simple but complete management system for cinemas to create movie entries, rooms with a visual editor, movie events and reservations but also a user management system to handle users and permissions."
                                }
