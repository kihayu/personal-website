                    {
                      "id": "oeamtc-main",
                      "type": "project-entry",
                      "schemaVersion": 1,
                      "props": {
                        "title": "ÖAMTC Website",
                        "leadText": "Working on multiple frontend and backend projects of ÖAMTC requires a consistent interface, fast performance, and an excellent user experience.",
                        "description": {
                          "type": "doc",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "As a frontend developer, I worked in a team on the website of ÖAMTC. Parts of the website are constantly rebuilt using Nuxt with TypeScript, optimized for performance and components from the styleguide. I also worked on the backend of the website, using PHP to extend and maintain the existing Content Management System. Additionally, I contributed a new technology stack for components, which needed work on frontend and backend. The design was built with a mobile-first approach, as most users nowadays use mobile devices to navigate the web."
                                }
