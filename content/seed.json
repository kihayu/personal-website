                    {
                      "id": "oegb",
                      "type": "project-entry",
                      "schemaVersion": 1,
                      "props": {
                        "title": "ÖGB and GPA",
                        "leadText": "A new implementation of the ÖGB and GPA webpages with a fresh and modern design. Involved the implementation of a proxy server between AEM and React.",
                        "description": {
                          "type": "doc",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Creating a frontend application that gets data from an Adobe Experience Manager (AEM) instance and works with Hot Module Reloading (HMR) was a challenge. I helped create a Webpack proxy server that handled the communication and data flow between AEM and our React frontend. The application itself uses React with TailwindCSS for styling."
                                }
                              ]
                            }
                          ]
