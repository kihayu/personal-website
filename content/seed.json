                    {
                      "id": "personal-website",
                      "type": "project-entry",
                      "schemaVersion": 1,
                      "props": {
                        "title": "Personal Website",
                        "leadText": "A responsive Nuxt website, showcasing my portfolio and professional journey. Designed with performance, SEO and user experience in mind.",
                        "description": {
                          "type": "doc",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
